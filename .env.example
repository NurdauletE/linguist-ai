# Скопируйте этот файл в .env.local и укажите ваши API-ключи.
# Команда: copy .env.example .env.local  (Windows)
#          cp .env.example .env.local    (Linux/Mac)
#
# Ключ для DeepSeek (чат, перевод, пунктуация)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# Ключ для OpenAI Whisper (распознавание речи с максимальной точностью)
# Получить ключ: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
